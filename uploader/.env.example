# Copy this file to uploader/.env before M2. uploader/.env is gitignored.
# Use the same API key as the root .env. Generate one with: openssl rand -hex 32

# Folder watched by chokidar. Use forward slashes.
# For the local phone demo the default is .demo/foto-hp in the repo root.
WATCH_DIR=E:/Website Project/seketika/.demo/foto-hp

# API endpoint and key. BASE_URL in the root .env must match this host.
API_BASE_URL=http://127.0.0.1:8000/api
API_KEY=REPLACE_WITH_the_same_32_BYTE_RANDOM_HEX_STRING

# Local panel. SEC-55 requires the loopback interface only.
PANEL_HOST=127.0.0.1
PANEL_PORT=4000

# Resize and retry settings from FR-11 and FR-12.
PHOTO_MAX_EDGE=2000
JPEG_QUALITY=85
RETRY_INTERVAL_MS=5000
MAX_RETRIES=20
